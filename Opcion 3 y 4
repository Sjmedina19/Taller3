 //Las utilidades
    static Producto buscarProductoPorId(ArrayList<Producto> productos, int id) {
        for (int i = 0; i < productos.size(); i++) {
            if (productos.get(i).id == id) return productos.get(i);
        }
        return null;
    }

    static Cliente buscarClientePorId(ArrayList<Cliente> clientes, int id) {
        for (int i = 0; i < clientes.size(); i++) {
            if (clientes.get(i).id == id) return clientes.get(i);
        }
        return null;
    }

    static boolean contieneId(ArrayList<Integer> lista, int id) {
        for (int i = 0; i < lista.size(); i++) {
            if (lista.get(i) == id) return true;
        }
        return false;
    }

    //Ordenamientos
    // Ordenar ventas por total DESC mayor a menor
    static void ordenarVentasPorTotalDesc(ArrayList<VentaProducto> ventas) {
        // Selection sort
        for (int i = 0; i < ventas.size() - 1; i++) {
            int maxIdx = i;
            for (int j = i + 1; j < ventas.size(); j++) {
                if (ventas.get(j).total > ventas.get(maxIdx).total) {
                    maxIdx = j;
                }
            }
            if (maxIdx != i) {
                VentaProducto tmp = ventas.get(i);
                ventas.set(i, ventas.get(maxIdx));
                ventas.set(maxIdx, tmp);
            }
        }
    }

    // Ordenar clientes por nombre ASC (A-Z)
    static void ordenarClientesPorNombreAsc(ArrayList<Cliente> clientes) {
        // Selection sort (alfabético)
        for (int i = 0; i < clientes.size() - 1; i++) {
            int minIdx = i;
            for (int j = i + 1; j < clientes.size(); j++) {
                String a = clientes.get(j).nombre.toLowerCase();
                String b = clientes.get(minIdx).nombre.toLowerCase();
                if (a.compareTo(b) < 0) {
                    minIdx = j;
                }
            }
            if (minIdx != i) {
                Cliente tmp = clientes.get(i);
                clientes.set(i, clientes.get(minIdx));
                clientes.set(minIdx, tmp);
            }
        }
    }

    // Opcion 3
    static void opcion3_calcularTotalVentasPorProducto(
            String productosCsv,
            String pedidosCsv,
            String totalVentasCsv
    ) {
        ArrayList<Producto> productos = leerProductos(productosCsv);
        ArrayList<Pedido> pedidos = leerPedidos(pedidosCsv);

        ArrayList<VentaProducto> ventas = new ArrayList<>();

        // Inicializar totales en 0 por cada producto
        for (int i = 0; i < productos.size(); i++) {
            Producto p = productos.get(i);
            ventas.add(new VentaProducto(p.id, p.nombre, 0));
        }

        // Acumular total = cantidad * precio
        for (int i = 0; i < pedidos.size(); i++) {
            Pedido ped = pedidos.get(i);
            Producto prod = buscarProductoPorId(productos, ped.productoId);
            if (prod == null) continue;

            long subtotal = (long) ped.cantidad * prod.precio;

            // sumar a su producto en la lista ventas
            for (int k = 0; k < ventas.size(); k++) {
                if (ventas.get(k).productoId == prod.id) {
                    ventas.get(k).total += subtotal;
                    break;
                }
            }
        }

        // Ordenar por total DESC
        ordenarVentasPorTotalDesc(ventas);

        // Mostrar en consola
        System.out.println("\n=== Total de ventas por producto (DESC) ===");
        for (int i = 0; i < ventas.size(); i++) {
            VentaProducto v = ventas.get(i);
            System.out.println(v.productoId + " | " + v.nombreProducto + " | " + v.total);
        }

        // Escribir CSV total_ventas.csv
        try (BufferedWriter bw = new BufferedWriter(new FileWriter(totalVentasCsv))) {
            bw.write("producto_id,nombre_producto,total");
            bw.newLine();
            for (int i = 0; i < ventas.size(); i++) {
                VentaProducto v = ventas.get(i);
                bw.write(v.productoId + "," + v.nombreProducto + "," + v.total);
                bw.newLine();
            }
            System.out.println("\nArchivo escrito: " + totalVentasCsv);
        } catch (IOException e) {
            System.out.println("Error escribiendo total_ventas.csv: " + e.getMessage());
        }
    }

    // Opcion 4
    // Muestra clientes que han comprado, ordenados A-Z
    static void opcion4_verClientesQueHanComprado(String clientesCsv, String pedidosCsv) {
        ArrayList<Cliente> clientes = leerClientes(clientesCsv);
        ArrayList<Pedido> pedidos = leerPedidos(pedidosCsv);

        // Sacar IDs únicos de clientes que aparecen en pedidos
        ArrayList<Integer> idsCompradores = new ArrayList<>();
        for (int i = 0; i < pedidos.size(); i++) {
            int cid = pedidos.get(i).clienteId;
            if (!contieneId(idsCompradores, cid)) {
                idsCompradores.add(cid);
            }
        }

        // Construir lista de clientes compradores
        ArrayList<Cliente> compradores = new ArrayList<>();
        for (int i = 0; i < idsCompradores.size(); i++) {
            Cliente c = buscarClientePorId(clientes, idsCompradores.get(i));
            if (c != null) compradores.add(c);
        }

        // Ordenar por nombre ASC
        ordenarClientesPorNombreAsc(compradores);

        // Mostrar
        System.out.println("\n=== Clientes que han realizado compras (A-Z) ===");
        for (int i = 0; i < compradores.size(); i++) {
            Cliente c = compradores.get(i);
            System.out.println(c.id + " | " + c.nombre + " | " + c.email);
        }

        if (compradores.size() == 0) {
            System.out.println("(No hay clientes con compras registradas)");
        }
    }

   
