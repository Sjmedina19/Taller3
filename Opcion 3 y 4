//ArrayList para la lectura del csvv
static ArrayList<Producto> leerProductos(String ruta) {
        ArrayList<Producto> productos = new ArrayList<>();
        try (BufferedReader br = new BufferedReader(new FileReader(ruta))) {
            String linea = br.readLine(); // header
            while ((linea = br.readLine()) != null) {
                String[] p = linea.split(",");
                int id = Integer.parseInt(p[0].trim());
                String nombre = p[1].trim();
                String categoria = p[2].trim();
                long precio = Long.parseLong(p[3].trim());
                int stock = Integer.parseInt(p[4].trim());
                productos.add(new Producto(id, nombre, categoria, precio, stock));
            }
        } catch (IOException e) {
            System.out.println("Error leyendo productos: " + e.getMessage());
        }
        return productos;
    }

